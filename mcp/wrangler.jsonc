{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "specification-email-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.specification.email", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
