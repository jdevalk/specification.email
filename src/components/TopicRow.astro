---
import StatusBadge from "./StatusBadge.astro";
interface Props {
  href: string;
  title: string;
  summary: string;
  status: string;
}
const { href, title, summary, status } = Astro.props;
---

<a class="topic-row" href={href}>
  <StatusBadge status={status} />
  <span class="topic-row__text">
    <h2>{title}</h2>
    <p>{summary}</p>
  </span>
  <span class="topic-row__arrow" aria-hidden="true">→</span>
</a>
