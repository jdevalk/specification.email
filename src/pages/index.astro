---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { categories } from "~/lib/site";

const topics = await getCollection("spec", ({ data }) => !data.draft);
const counts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    topics.filter((topic) => topic.data.category === category.slug).length,
  ]),
);
const changes = (await getCollection("changelog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
---

<BaseLayout
  title="Email standards for better messages"
  description="Build reliable email with sourced guidance for authentication, deliverability, accessibility, privacy, security, and client rendering."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>What a good email does.</h1>
        <p class="lede">
          A sourced specification for every technical detail that matters: from <code
            >From:</code
          > and MIME to DMARC, one-click unsubscribe, accessible HTML, and dark mode. Written
          for humans and agents.
        </p>
        <div class="actions">
          <a class="button primary" href="/spec/">Browse all {topics.length} topics →</a>
          <a class="button" href="/checklist/">Get the checklist</a>
          <a class="button" href="/mcp/">Connect an agent</a>
        </div>
      </div>
      <aside class="use-card" aria-labelledby="use-title">
        <h2 id="use-title">How to use this site</h2>
        <ol>
          <li>
            <span class="use-n" aria-hidden="true">01</span>
            <div>
              <h3>Audit</h3>
              <p>
                Run the <a href="/checklist/">checklist</a> against a message or sending domain,
                or <a href="/mcp/">let your agent</a> do it. Each item is a yes/no.
              </p>
            </div>
          </li>
          <li>
            <span class="use-n" aria-hidden="true">02</span>
            <div>
              <h3>Learn</h3>
              <p>Open any item for what it is, why it matters, and how to implement it.</p>
            </div>
          </li>
          <li>
            <span class="use-n" aria-hidden="true">03</span>
            <div>
              <h3>Improve</h3>
              <p>Fix what's missing, send a test message, then re-check.</p>
            </div>
          </li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="container section">
    <div class="section-header">
      <div><h2>Recently changed</h2></div><a href="/changelog/">Full changelog →</a>
    </div>
    <ol class="timeline">
      {
        changes.map((change) => (
          <li>
            <>
              <time datetime={change.data.date}>{change.data.date}</time>
              <h3>
                <a href={`/changelog/#${change.id}`}>{change.data.title}</a>
              </h3>
            </>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section">
    <div class="section-header">
      <div><h2>Ten parts of good email</h2></div><a href="/spec/">Browse all topics →</a>
    </div>
    <div class="grid">
      {
        categories.map((category) => (
          <a class="card" href={`/spec/${category.slug}/`}>
            <span class="card-head">
              <h3>{category.title}</h3>
              <span class="count">{counts[category.slug]} topics</span>
            </span>
            <p>{category.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="principles section">
    <div class="container">
      <div class="section-header">
        <div><h2>One contract, many clients</h2></div>
      </div>
      <div class="principles-grid">
        <div class="principle">
          <div>
            <h3>Standards, not folklore</h3><p>
              Every topic cites the RFC, W3C guidance, or authoritative operator
              documentation behind it.
            </p>
          </div>
        </div>
        <div class="principle">
          <div>
            <h3>Provider-agnostic</h3><p>
              The outcome matters. Use any ESP, MTA, framework, or template system that can
              meet it.
            </p>
          </div>
        </div>
        <div class="principle">
          <div>
            <h3>Test the delivered message</h3><p>
              Generated source is not the result. Verify what arrives after relays, filters,
              and clients touch it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
